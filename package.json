{
  "name": "cuenca-austral",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/anclas.mjs && vite",
    "build": "node scripts/anclas.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "test": "node scripts/anclas.mjs && vitest run",
    "test:watch": "vitest",
    "data:fetch": "python3 -m pipeline.fetch_capiv && python3 -m pipeline.fetch_geo",
    "data:build": "python3 -m pipeline.build_data",
    "anclas": "node scripts/anclas.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^27.0.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "vitest": "^5.0.3"
  }
}
